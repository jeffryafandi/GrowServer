{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "DISCORD_BOT_TOKEN",
        "BETTER_AUTH_SECRET",
        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET"
      ]
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "dependsOn": ["^setup"],
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
